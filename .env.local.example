# Supabase
# URL e chave anônima (pública) do projeto Supabase.
# Seguras para uso no client (browser) — protegidas por RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role do Supabase.
# NUNCA expor no client. Usar apenas em código server-only
# (Server Actions, Route Handlers) — ver src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (usada em e-mails, links de redefinição de senha, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
