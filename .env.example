# Template de variáveis de ambiente do projeto.
# Copie para `.env.local` (não versionado) e preencha com as credenciais do
# projeto Supabase (Project Settings > API). Detalhes de cada variável em
# `.env.local.example` e `docs/ARCHITECTURE.md`.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (usada em e-mails, links de redefinição de senha, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
